{
  "name": "@luminarylabs/nexusengine-editor",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Static NexusEngine web editor shell for building DSK-driven games as HTML files.",
  "exports": {
    "./headless": "./src/headless/index.js",
    "./adapters/node-mcp-sdk": "./src/adapters/node-mcp-sdk-adapter.js",
    "./headless/strict": "./src/headless/strict.js",
    "./headless/development": "./src/headless/development.js",
    "./authoring": "./src/authoring/index.js",
    "./authoring/storage/browser": "./src/authoring/storage/browser-project.js",
    "./authoring/preview": "./src/authoring/preview/localhost-server.js"
  },
  "nexusEngineArtifact": {
    "version": "0.0.4",
    "commit": "a74e8689d1a71c0b42236c009f0f4c46e9b89387",
    "registryHash": "sha256:d2b8af8d1d542bdb125d33b8a4ff5a32de1cf73da399e57e9a29b5ae35d4a8f5",
    "tarballSha256": "5a7e2985fd1c67e1204490570e7ccf008eff742f157485bfa552881584b2883b"
  },
  "scripts": {
    "build": "node scripts/build-static-site.mjs",
    "build:game": "node scripts/build-dsk-game-html.mjs examples/dsk-games/starter-game.json dist/games/starter-game.html",
    "cli": "node scripts/nexus-engine-editor-cli.mjs",
    "cli:chess": "node scripts/nexus-engine-editor-cli.mjs operations submit chess-game --param html=dist/games/nexus-chess.html --param project=dist/games/nexus-chess.project.json",
    "cli:target-clicker": "node scripts/nexus-engine-editor-cli.mjs operations submit target-clicker-game --param html=dist/games/nexus-target-clicker.html --param project=dist/games/nexus-target-clicker.project.json",
    "cli:gem-collector": "node scripts/nexus-engine-editor-cli.mjs operations submit gem-collector-game --param html=dist/games/nexus-gem-collector.html --param project=dist/games/nexus-gem-collector.project.json",
    "mcp:screenshot": "node scripts/nexus-engine-editor-screenshot-mcp.mjs",
    "mcp:game": "node examples/mcp-game-runtime.mjs",
    "smoke:intent": "node scripts/intent-smoke.mjs",
    "smoke:playwright": "node tests/playwright-editor-smoke.mjs",
    "test": "npm run test:headless && npm run test:authoring && npm run smoke:intent && npm run build && npm run smoke:playwright",
    "test:headless": "node tests/headless-strict.mjs",
    "authoring": "node scripts/nexus-authoring.mjs",
    "test:authoring": "node tests/run-authoring.mjs",
    "benchmark:authoring": "node benchmarks/authoring.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.61.1"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  },
  "dependencies": {
    "esbuild": "0.25.10",
    "gltf-validator": "2.0.0-dev.3.10",
    "pngjs": "7.0.0",
    "three": "0.180.0",
    "nexusengine": "git+https://github.com/LuminaryLabs-Dev/NexusEngine.git#a74e8689d1a71c0b42236c009f0f4c46e9b89387"
  },
  "bin": {
    "nexus-authoring": "./scripts/nexus-authoring.mjs"
  },
  "nexusProviderArtifact": {
    "package": "@luminarylabs/nexusengine-kits",
    "version": "0.0.1",
    "commit": "a7abd1340d8f695abc8974121fdd2ef4112413c0",
    "tarballSha256": "7998e910d00370872dee8ebf0c472b64df99f0f1644a87cdb65b103e3345e4f3",
    "requiredByAuthoringHost": false
  }
}
